 _logger = logging.getLogger(__name__)
+_INPUT_SYSFS = Path('/sys/class/input')
+
+
+def _sdl_to_dolphin_evdev_buttons(pad: Controller) -> dict[int, int]:
+    """Translate SDL button slots to Dolphin's evdev slots for this live device."""
+    if environ.get('EMBERCADE_DESKTOP') != '1':
+        return {}
+    event_name = Path(pad.device_path).name
+    if re.fullmatch(r'event\d+', event_name) is None:
+        return {}
+    try:
+        words = (_INPUT_SYSFS / event_name / 'device/capabilities/key').read_text().split()
+        bits = 0
+        for word in words:
+            bits = (bits << 64) | int(word, 16)
+    except (OSError, ValueError):
+        return {}
+    codes = [code for code in range(bits.bit_length()) if bits & (1 << code)]
+    if len(codes) != pad.button_count or not any(code < 0x120 for code in codes):
+        return {}
+    # SDL's Linux joystick backend enumerates BTN_JOYSTICK+ first, then
+    # lower key codes. Dolphin evdev enumerates all key codes ascending.
+    sdl_codes = [code for code in codes if code >= 0x120]
+    sdl_codes.extend(code for code in codes if code < 0x120)
+    evdev_slots = {code: slot for slot, code in enumerate(codes)}
+    return {slot: evdev_slots[code] for slot, code in enumerate(sdl_codes)}
 
 
