 RETROARCH_CORES: Final = Path(os.environ.get('EMBERCADE_LIBRETRO_CORES', '/usr/lib/libretro'))
 RETROARCH_SHARE: Final = Path(os.environ.get('EMBERCADE_LIBRETRO_SHARE', '/usr/share/libretro'))
+
+
+def retroarch_core_path(core_name: str) -> Path:
+    """Use Embercade's exact host-core resolution for the requested core only."""
+    override = os.environ.get('EMBERCADE_LIBRETRO_CORE')
+    override_name = os.environ.get('EMBERCADE_LIBRETRO_CORE_NAME')
+    if override and override_name == core_name:
+        return Path(override)
+    return RETROARCH_CORES / f'{core_name}_libretro.so'
