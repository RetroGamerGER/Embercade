+def _desktop_exit_binding(pad, hotkey, start) -> str:
+    """Use the same SDL-to-evdev button slots as Dolphin's pad configuration."""
+    evdev_buttons = controllers._sdl_to_dolphin_evdev_buttons(pad)
+
+    def button_id(inp) -> str:
+        try:
+            button = int(inp.id)
+        except ValueError:
+            return inp.id
+        return str(evdev_buttons.get(button, button))
+
+    return f'`Button {button_id(hotkey)}` & `Button {button_id(start)}`'
+
