+def _sdl_reservation_id(controller: Controller) -> str | None:
+    # SDL GUID bytes 4:6 and 8:10 encode the USB vendor and product IDs,
+    # including for Bluetooth pads. RetroArch can reserve by this stable pair.
+    try:
+        guid = bytes.fromhex(controller.guid)
+    except ValueError:
+        return None
+    if len(guid) != 16:
+        return None
+    vendor = int.from_bytes(guid[4:6], 'little')
+    product = int.from_bytes(guid[8:10], 'little')
+    if not vendor or not product:
+        return None
+    return f'{vendor:04x}:{product:04x}'
+
+
