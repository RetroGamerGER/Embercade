 std::string TextEditComponent::getValue() const
 {
 	return mText;
+}
+
+bool TextEditComponent::pasteFromClipboard()
+{
+    // Read only on an explicit paste action; never log or export clipboard data.
+    if (!SDL_HasClipboardText()) return false;
+    char* raw = SDL_GetClipboardText();
+    if (!raw) return false;
+    const auto length = strnlen(raw, 16385);
+    if (!length || length > 16384) { SDL_free(raw); return false; }
+    std::string text(raw, length);
+    SDL_free(raw);
+    for (unsigned char c : text)
+        if (c == 127 || (c < 32 && !(isMultiline() && (c == '\n' || c == '\r' || c == '\t'))))
+            return false;
+    if (mText.size() + text.size() > (mPassword ? 2048u : 16384u)) return false;
+    mText.insert(mCursor, text);
+    mCursor += static_cast<unsigned int>(text.size());
+    mCursorRepeatDir = 0;
+    mBlinkTime = 0;
+    onTextChanged();
+    onCursorChanged();
+    return true;
 }
 
