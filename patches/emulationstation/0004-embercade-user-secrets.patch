+	// Write preferences through an owner-only sibling, then atomically replace
+	// the old file. This also safely removes legacy account fields on migration.
+	std::string temporaryTemplate = path + ".tmp.XXXXXX";
+	std::vector<char> temporary(temporaryTemplate.begin(), temporaryTemplate.end());
+	temporary.push_back('\0');
+	int descriptor = mkstemp(temporary.data());
+	if (descriptor < 0)
+		return false;
+	close(descriptor);
+	std::string temporaryName(temporary.data());
+	if (!doc.save_file(WINSTRINGW(temporaryName).c_str()))
+	{
+		unlink(temporary.data());
+		return false;
+	}
+	if (chmod(temporary.data(), 0600) != 0)
+	{
+		unlink(temporary.data());
+		return false;
+	}
+	descriptor = open(temporary.data(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	bool written = descriptor >= 0 && fsync(descriptor) == 0;
+	if (descriptor >= 0) close(descriptor);
+	if (!written || rename(temporary.data(), path.c_str()) != 0)
+	{
+		unlink(temporary.data());
+		return false;
+	}
